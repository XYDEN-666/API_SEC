# APIShield environment configuration
# -----------------------------------
# Copy this file to `.env` to override the defaults below, then run:
#   docker compose up -d --build
# Every variable has a working default, so a local run needs no `.env` at all.

# --- Backend (FastAPI) ---------------------------------------------------
# Pydantic settings are read directly from the environment by the backend.
APP_NAME=APIShield
DEBUG=false

# Async SQLAlchemy URL used by the backend and worker.
# The host part must be the compose service name `postgres`.
DATABASE_URL=postgresql+asyncpg://apishield:apishield@postgres:5432/apishield

# Celery broker URL; host must be the compose service name `redis`.
REDIS_URL=redis://redis:6379/0

# JWT signing secret (HS256). The default is DEVELOPMENT-ONLY. Generate a
# strong one for any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-apishield-secret-key-change-me-0123456789abcdef

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key for encrypting stored credentials (urlsafe-base64, 32 bytes).
# The default is DEVELOPMENT-ONLY. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=P4vHutRJRUJn68B0vvg3UPIFNzMK3Y8apKih1ZR6v44=

# Allowed browser origins for CORS, as a JSON array.
CORS_ORIGINS=["http://localhost:5173","http://host.docker.internal:5174"]

# --- PostgreSQL -----------------------------------------------------------
# Used by the postgres service and to build DATABASE_URL if you keep the
# default connection string format above.
POSTGRES_USER=apishield
POSTGRES_PASSWORD=apishield
POSTGRES_DB=apishield

# --- Frontend (Vite) ------------------------------------------------------
# Base URL the browser uses to reach the backend API. Inlined at build/dev
# time by Vite.
VITE_API_BASE_URL=http://localhost:8000
