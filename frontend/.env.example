# Optional override for the backend the UI talks to.
#
# Leave this unset for local development: `npm run dev` probes
# http://localhost:8000 (the Docker backend) and then http://localhost:8001
# (the fixture API started by `npm run dev:mock`) and uses the first that
# answers. Set it to pin one explicitly — the value is baked in at build time.
#
# VITE_API_BASE_URL=http://localhost:8000
