<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>APIShield Report &mdash; Scan #{{ data.metadata.scan_id }}</title>
  <style>
    body {
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
        sans-serif;
      color: #1f2937;
      margin: 2rem auto;
      max-width: 60rem;
      padding: 0 1rem;
      line-height: 1.5;
    }
    h1 { border-bottom: 3px solid #2563eb; padding-bottom: .5rem; }
    h2 { margin-top: 2rem; color: #1e40af; }
    h3 { margin-top: 1.5rem; color: #374151; }
    .meta { color: #4b5563; }
    table.summary { border-collapse: collapse; min-width: 20rem; }
    table.summary th, table.summary td {
      border: 1px solid #d1d5db;
      padding: .4rem .8rem;
      text-align: left;
    }
    table.summary th { background: #eff6ff; }
    .badge {
      display: inline-block;
      border-radius: 9999px;
      padding: .1rem .6rem;
      font-size: .75rem;
      font-weight: 600;
      color: #fff;
    }
    .badge.critical { background: #b91c1c; }
    .badge.high { background: #ea580c; }
    .badge.medium { background: #d97706; }
    .badge.low { background: #16a34a; }
    .badge.info { background: #64748b; }
    .badge.risk { background: #2563eb; }
    .finding {
      border: 1px solid #e5e7eb;
      border-left: 4px solid #2563eb;
      border-radius: .35rem;
      padding: .8rem 1rem;
      margin: 1rem 0;
    }
    .endpoint {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .85rem;
      color: #374151;
    }
    dl { display: grid; grid-template-columns: 10rem 1fr; }
    dt { font-weight: 600; color: #4b5563; }
    dd { margin: 0; }
    details { margin-top: .6rem; }
    summary { cursor: pointer; font-weight: 600; color: #1e40af; }
    pre {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: .25rem;
      padding: .6rem;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: .8rem;
    }
    footer { margin-top: 3rem; color: #9ca3af; font-size: .8rem; }
    @media print {
      body { margin: 0; }
      details { display: block; }
      summary { list-style: none; }
    }
  </style>
</head>
<body>
  <h1>APIShield Scan Report</h1>
  <p class="meta">
    Project: {{ data.metadata.project_name }} &middot;
    Target: {{ data.metadata.target_name }} ({{ data.metadata.base_url }})<br>
    Scan #{{ data.metadata.scan_id }} &middot;
    Status: {{ data.metadata.status }} &middot;
    Started: {{ data.metadata.started_at or "n/a" }} &middot;
    Finished: {{ data.metadata.finished_at or "n/a" }}<br>
    Generated: {{ data.metadata.generated_at }}
  </p>

  <h2>Summary</h2>
  <table class="summary">
    <tr><th>Severity</th><th>Findings</th></tr>
    <tr><td>Critical</td><td>{{ data.summary.critical }}</td></tr>
    <tr><td>High</td><td>{{ data.summary.high }}</td></tr>
    <tr><td>Medium</td><td>{{ data.summary.medium }}</td></tr>
    <tr><td>Low</td><td>{{ data.summary.low }}</td></tr>
    <tr><td>Info</td><td>{{ data.summary.info }}</td></tr>
    <tr><td><strong>Total</strong></td><td><strong>{{ data.summary.total }}</strong></td></tr>
  </table>

  <h2>Findings by OWASP Category</h2>
  {% for category, category_findings in data.findings | groupby("owasp_category") %}
    <h3>{{ category_label(category) }}</h3>
    {% for finding in category_findings %}
      <article class="finding">
        <header>
          <strong>{{ finding.title }}</strong>
          <span class="badge {{ finding.severity }}">{{ finding.severity | upper }}</span>
          <span class="badge risk">Risk: {{ finding.risk_label }} ({{ finding.risk_score }}/10)</span>
        </header>
        <p>{{ finding.description }}</p>
        <p class="endpoint">{{ finding.endpoint }}</p>
        <dl>
          <dt>OWASP category</dt><dd>{{ finding.owasp_category }}</dd>
          <dt>Confidence</dt><dd>{{ finding.confidence }}</dd>
          <dt>Risk score</dt><dd>{{ finding.risk_score }}/10</dd>
        </dl>
        {% if finding.evidence %}
          <details>
            <summary>Evidence ({{ finding.evidence.scanner_name }})</summary>
            <pre>request: {{ finding.evidence.request_data }}</pre>
            <pre>response: {{ finding.evidence.response_data }}</pre>
          </details>
        {% endif %}
      </article>
    {% endfor %}
  {% else %}
    <p>No findings for this scan.</p>
  {% endfor %}

  <footer>Generated by APIShield &mdash; API Security Assessment Platform</footer>
</body>
</html>
